// Схема базы VanillaCoins. Единственный источник правды для сайта и плагина.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Аккаунты ───────────────────────────────

model User {
  id           String    @id @default(cuid())
  login        String    @unique // он же ник в игре
  email        String    @unique
  passwordHash String
  balanceVc    Int       @default(0)
  /// Осколки: дубли из кейсов превращаются в них, за них покупают нужный предмет.
  shards       Int       @default(0)
  playtimeSec  Int       @default(0)
  adminLevel   Int       @default(0) // 0 игрок, 1 media … 5 chief
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?
  lastIp       String?

  /// Когда игрок принял соглашение и политику — фиксируем при регистрации.
  acceptedTermsAt DateTime?

  /// Промокод, введённый при регистрации. Привязывается один раз и навсегда.
  referredByPromoId String?
  referredByPromo   Promo?  @relation("PromoReferrals", fields: [referredByPromoId], references: [id], onDelete: SetNull)

  twoFactorCode      String?
  twoFactorExpiresAt DateTime?

  /// TOTP для входа в админ-панель. У обычных игроков не используется.
  totpSecret    String?
  totpEnabledAt DateTime?

  knownIps             KnownIp[]
  sessions             Session[]
  loginAttempts        LoginAttempt[]
  punishments          Punishment[]         @relation("PunishedUser")
  issued               Punishment[]         @relation("PunishedBy")
  reports              Report[]             @relation("ReportAuthor")
  claimedReports       Report[]             @relation("ReportClaimer")
  transactions         Transaction[]
  promoActivation      PromoActivation[]
  bonusUses            BonusUse[]
  caseOpenings         CaseOpening[]
  gameRounds           GameRound[]
  seeds                Seed[]
  cosmetics            UserCosmetic[]
  auditEntries         AuditLog[]           @relation("AuditActor")
  auditTargets         AuditLog[]           @relation("AuditTarget")
  flags                SuspiciousFlag[]
  payments             Payment[]
  reviewedPayments     Payment[]            @relation("PaymentReviewer")
  appeals              Appeal[]             @relation("AppealAuthor")
  reviewedAppeals      Appeal[]             @relation("AppealReviewer")
  serverActions        ServerAction[]
  liveBets             LiveBet[]
  tickets              Ticket[]
  giveawayEntries      GiveawayEntry[]
  caseTickets          CaseTicket[]
  diceChallenges       DiceMatch[]          @relation("DiceChallenger")
  diceOpponents        DiceMatch[]          @relation("DiceOpponent")
  diceWins             DiceMatch[]          @relation("DiceWinner")
  createdGiveaways     Giveaway[]           @relation("GiveawayAuthor")
  wonGiveaways         Giveaway[]           @relation("GiveawayWinner")
  ticketMessages       TicketMessage[]      @relation("TicketAuthor")
  settings             Setting[]            @relation("SettingEditor")
  shopPurchases        ShopPurchase[]
  ownedPromos          Promo[]              @relation("PromoPartner")
  news                 News[]               @relation("NewsAuthor")
  partnerApplications  PartnerApplication[] @relation("ApplicationAuthor")
  reviewedApplications PartnerApplication[] @relation("ApplicationReviewer")

  @@index([adminLevel])
}

/// Уровень аккаунта считается из наигранного времени, а не хранится.
model KnownIp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  hits      Int      @default(1)

  @@unique([userId, ip])
  @@index([ip])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  /// Доступ в панель подтверждается отдельно и живёт меньше самой сессии.
  panelVerifiedUntil DateTime?

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  login     String
  ip        String
  source    String // "web" | "game"
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([login, createdAt])
}

// ─────────────────────────────── Наказания ───────────────────────────────

enum PunishmentType {
  JAIL
  WARN
  BAN
}

model Punishment {
  id       String         @id @default(cuid())
  type     PunishmentType
  userId   String
  user     User           @relation("PunishedUser", fields: [userId], references: [id], onDelete: Cascade)
  byUserId String?
  by       User?          @relation("PunishedBy", fields: [byUserId], references: [id], onDelete: SetNull)
  reason   String

  issuedAt  DateTime  @default(now())
  expiresAt DateTime? // для WARN и BAN
  active    Boolean   @default(true)
  liftedAt  DateTime?
  liftedBy  String?

  // только для JAIL
  totalSeconds     Int?
  remainingSeconds Int?
  blocksMined      Int?    @default(0)
  inventoryData    String?
  returnLocation   String?

  @@index([userId, type, active])
}

// ──────────────────────────────── Репорты ────────────────────────────────

enum ReportStatus {
  OPEN
  CLAIMED
  CLOSED
}

model Report {
  id          String       @id @default(cuid())
  authorId    String
  author      User         @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  text        String
  status      ReportStatus @default(OPEN)
  claimedById String?
  claimedBy   User?        @relation("ReportClaimer", fields: [claimedById], references: [id], onDelete: SetNull)
  claimedAt   DateTime?
  closedAt    DateTime?
  resolution  String?
  createdAt   DateTime     @default(now())

  @@index([status, createdAt])
}

// ─────────────────────────────── Экономика ───────────────────────────────

enum TxType {
  TOPUP
  CASE_OPEN
  CASE_REWARD
  GAME_BET
  GAME_WIN
  PROMO
  BONUS
  DAILY
  EVENT
  SHOP_BUY
  PARTNER_SHARE
  ADMIN_ADJUST
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         TxType
  amount       Int // может быть отрицательным
  balanceAfter Int
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

/// Заявка на пополнение. Провайдера нет: игрок переводит деньги и оставляет
/// контакт, чиф-администратор сверяет перевод и одобряет — тогда начисляются VC.
model Payment {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountRub  Int
  vcAmount   Int
  /// Сколько из vcAmount дал бонус кассы — для истории и панели.
  bonusVc    Int       @default(0)
  provider   String
  providerId String?   @unique
  /// pending | paid | rejected
  status     String    @default("pending")
  /// Как игрок платил и куда с ним связаться — по этому админ ищет перевод.
  method     String?
  contact    String?
  comment    String?
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  reviewedById String?
  reviewedBy   User?     @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ──────────────────── Общие раунды мини-игр ─────────────────────────────

enum LiveGame {
  ROULETTE
  CRASH
}

/// Раунд, общий для всех игроков. Номер считается от эпохи, поэтому расписание
/// одинаковое для любого процесса сайта и не требует отдельного планировщика.
model LiveRound {
  id     String   @id @default(cuid())
  game   LiveGame
  number Int

  /// Ставки принимаются от startedAt до lockAt, дальше розыгрыш и показ.
  startedAt DateTime
  lockAt    DateTime
  endsAt    DateTime

  serverSeed     String
  serverSeedHash String

  /// Бросок [0,1). Заполняется при розыгрыше — до него результата нет ни у кого.
  roll       Float?
  /// Рулетка: максимальный выигравший множитель (0 — мимо). Краш: точка краха.
  result     Float?
  resolvedAt DateTime?

  bets LiveBet[]

  @@unique([game, number])
  @@index([game, startedAt])
}

model LiveBet {
  id      String    @id @default(cuid())
  roundId String
  round   LiveRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  betVc     Int
  /// Множитель ставки в рулетке или точка авто-вывода в краше.
  target    Float
  payoutVc  Int      @default(0)
  won       Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([roundId, userId])
  @@index([userId, createdAt])
}

// ─────────────────────── Кости между игроками ────────────────────────────

/// Партия в кости на сервере. Ставки списываются до броска и лежат «в банке»,
/// пока партия не завершится: иначе проигравший успел бы потратить VC.
model DiceMatch {
  id     String @id @default(cuid())
  amount Int

  challengerId String
  challenger   User   @relation("DiceChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId   String
  opponent     User   @relation("DiceOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  /// escrow — ставки списаны, идёт бросок; paid — выплачено; refunded — возвращено
  status String @default("escrow")

  challengerRoll Int?
  opponentRoll   Int?
  winnerId       String?
  winner         User?   @relation("DiceWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  settledAt DateTime?

  @@index([status, createdAt])
  @@index([challengerId, createdAt])
}

// ───────────────────── Кейсы, купленные в игре ───────────────────────────

/// Оплаченный, но ещё не открытый кейс. Живёт как предмет в инвентаре игрока:
/// покупка списывает VC сразу, а выпадение считается в момент открытия.
model CaseTicket {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseKey String
  case    CaseType @relation(fields: [caseKey], references: [key], onDelete: Cascade)

  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId, usedAt])
}

// ──────────────────────────── Розыгрыши ──────────────────────────────────

/// Розыгрыш среди игроков. Условие — наигранное время: оно проверяется и при
/// участии, и в момент розыгрыша, чтобы победителем не стал случайный гость.
model Giveaway {
  id            String  @id @default(cuid())
  title         String
  prize         String
  description   String?
  /// Сколько часов надо наиграть, чтобы участвовать.
  requiredHours Int     @default(15)
  /// active — идёт, finished — победитель определён, cancelled — отменён
  status        String  @default("active")

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  createdById String?
  createdBy   User?   @relation("GiveawayAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  /// Победитель и сид розыгрыша: по нему результат пересчитывается вручную.
  winnerId  String?
  winner    User?     @relation("GiveawayWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  drawnAt   DateTime?
  drawSeed  String?
  drawnFrom Int?

  entries GiveawayEntry[]

  @@index([status, startsAt])
}

model GiveawayEntry {
  id           String   @id @default(cuid())
  giveawayId   String
  giveaway     Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Сколько часов было у игрока в момент участия — для разбора спорных случаев.
  hoursAtEntry Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([giveawayId, userId])
  @@index([userId])
}

// ───────────────────────── Обращения игроков ─────────────────────────────

/// Тикет в поддержку. Переписка идёт на сайте, разбирает её чиф-администратор.
model Ticket {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject String
  /// open — ждёт ответа администрации, answered — ответили, closed — закрыт
  status  String @default("open")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  messages TicketMessage[]

  @@index([status, updatedAt])
  @@index([userId, createdAt])
}

model TicketMessage {
  id        String  @id @default(cuid())
  ticketId  String
  ticket    Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?   @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Ответ администрации или сообщение игрока — по этому полю красим переписку.
  fromStaff Boolean @default(false)
  text      String

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// ──────────────────────── Настройки сайта ────────────────────────────────

/// Служебные настройки, которые меняются на ходу: например, техработы.
model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

// ─────────────────────── Заявления о разбане ─────────────────────────────

/// Заявление на разбан. Подаётся без входа на сайт: забаненный аккаунт в
/// игру не пускают, а на сайте он может и не помнить пароль.
model Appeal {
  id      String  @id @default(cuid())
  login   String
  userId  String?
  user    User?   @relation("AppealAuthor", fields: [userId], references: [id], onDelete: SetNull)
  contact String
  text    String
  /// pending | approved | rejected
  status  String  @default("pending")
  ip      String?

  /// Наказание, которое обжалуется — на момент подачи.
  punishmentId String?

  createdAt    DateTime  @default(now())
  reviewedById String?
  reviewedBy   User?     @relation("AppealReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  @@index([status, createdAt])
  @@index([login])
}

// ──────────────────── Поручения игровому серверу ─────────────────────────

/// Действие, которое должен выполнить плагин: например, очистить инвентарь
/// после обнуления аккаунта. Ждёт в очереди, пока игрок не зайдёт в игру.
model ServerAction {
  id          String    @id @default(cuid())
  /// WIPE_INVENTORY
  kind        String
  login       String
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  payload     Json?
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([deliveredAt, createdAt])
  @@index([login])
}

// ──────────────────────────── Магазин за VC ──────────────────────────────

/// Товар магазина. Это не косметика: здесь то, что даёт возможность в игре —
/// телепорты, дом, страховка инвентаря. Каталог наливается сидом.
model ShopItem {
  key           String  @id
  title         String
  description   String
  /// teleport | utility | insurance — для группировки на витрине
  category      String
  priceVc       Int
  /// CHARGES — тратится по использованию, PERMANENT — открывает возможность навсегда
  kind          String  @default("CHARGES")
  charges       Int     @default(0)
  /// Что именно даёт товар: {"feature":"tp"} — плагин смотрит сюда
  payload       Json?
  requiredLevel Int     @default(0)
  sort          Int     @default(0)
  active        Boolean @default(true)

  purchases ShopPurchase[]
}

/// Купленное игроком. Одна строка на товар: докупка складывает заряды.
model ShopPurchase {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey     String
  item        ShopItem  @relation(fields: [itemKey], references: [key], onDelete: Cascade)
  chargesLeft Int       @default(0)
  permanent   Boolean   @default(false)
  /// Состояние товара: например, координаты дома.
  data        Json?
  boughtTimes Int       @default(1)
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?

  @@unique([userId, itemKey])
  @@index([userId])
}

// ──────────────────────────── Промо и бонусы ─────────────────────────────

model Promo {
  id            String   @id @default(cuid())
  code          String   @unique
  partnerId     String?
  partner       User?    @relation("PromoPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  rewardVc      Int      @default(1000)
  requiredLevel Int      @default(3)
  active        Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())

  activations PromoActivation[]
  referrals   User[]            @relation("PromoReferrals")
}

/// Привязка игрока к промокоду. Награда выдаётся отдельно — по достижении уровня.
model PromoActivation {
  id         String    @id @default(cuid())
  promoId    String
  promo      Promo     @relation(fields: [promoId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Где ввели код: при регистрации на сайте или командой в игре.
  source     String    @default("web")
  rewardedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([promoId, userId])
  @@index([userId])
}

model BonusCode {
  id          String    @id @default(cuid())
  code        String    @unique
  rewardVc    Int
  maxUses     Int
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())

  uses BonusUse[]
}

model BonusUse {
  id        String    @id @default(cuid())
  codeId    String
  code      BonusCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([codeId, userId])
}

// ──────────────────────────── Кейсы и косметика ──────────────────────────

model CaseType {
  key         String  @id
  name        String
  description String  @default("")
  priceVc     Int
  active      Boolean @default(true)
  imageUrl    String?

  seasonKey      String?
  /// После этой даты кейс исчезает навсегда — вместе с шансом выбить его предметы.
  availableUntil DateTime?
  /// Бесплатное открытие раз в сутки.
  freeDaily      Boolean   @default(false)
  /// Гарант: столько открытий без легендарки — и она выпадает принудительно.
  pityThreshold  Int       @default(0)
  sortOrder      Int       @default(0)

  items    CaseItem[]
  openings CaseOpening[]
  tickets  CaseTicket[]
}

enum CaseItemKind {
  VC
  COSMETIC
  SHARDS
}

/// Что косметика делает в игре. Плагин смотрит на kind и payload.
enum CosmeticKind {
  TRAIL
  AURA
  PET
  HAT
  JOIN_EFFECT
  NAME_COLOR
  TITLE
  WORLD_MARK
}

model Cosmetic {
  key           String       @id
  name          String
  description   String
  kind          CosmeticKind
  rarity        String       @default("common")
  /// Параметры для плагина: частица, моб, звук, материал шляпы, цвет.
  payload       Json
  /// Сезон, в котором предмет выпадал. Прошедшие сезоны больше не выпадают.
  seasonKey     String?
  collectionKey String?
  collection    Collection?  @relation(fields: [collectionKey], references: [key], onDelete: SetNull)
  /// Лимит экземпляров: у первых владельцев будет номер #1, #2 и так далее.
  serialLimit   Int?
  /// Награда за коллекцию — в кейсах не выпадает.
  obtainable    Boolean      @default(true)
  shardPrice    Int?

  owners    UserCosmetic[]
  caseItems CaseItem[]
  rewardFor Collection[]   @relation("CollectionReward")
}

model Collection {
  key       String    @id
  name      String
  seasonKey String?
  /// Что дают за полный сбор.
  rewardKey String?
  reward    Cosmetic? @relation("CollectionReward", fields: [rewardKey], references: [key], onDelete: SetNull)

  items Cosmetic[]
}

model CaseItem {
  id          String       @id @default(cuid())
  caseKey     String
  case        CaseType     @relation(fields: [caseKey], references: [key], onDelete: Cascade)
  kind        CaseItemKind
  /// Для COSMETIC — ссылка на каталог, для VC и SHARDS — количество.
  cosmeticKey String?
  cosmetic    Cosmetic?    @relation(fields: [cosmeticKey], references: [key], onDelete: Cascade)
  amount      Int?
  weight      Int // вес в общей корзине, шанс = weight / sum(weight)

  openings CaseOpening[]

  @@index([caseKey])
}

/// Счётчик открытий без легендарки — по игроку на каждый кейс.
model PityCounter {
  id      String @id @default(cuid())
  userId  String
  caseKey String
  count   Int    @default(0)

  @@unique([userId, caseKey])
}

model CaseOpening {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseKey        String
  case           CaseType @relation(fields: [caseKey], references: [key], onDelete: Cascade)
  itemId         String
  item           CaseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  priceVc        Int
  /// Дубль превратился в осколки, а не в предмет.
  duplicate      Boolean  @default(false)
  /// Выдано гарантом, а не броском.
  fromPity       Boolean  @default(false)
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model UserCosmetic {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  cosmetic   Cosmetic @relation(fields: [key], references: [key], onDelete: Cascade)
  equipped   Boolean  @default(false)
  /// Номер экземпляра для лимитированных предметов.
  serial     Int?
  obtainedAt DateTime @default(now())

  @@unique([userId, key])
  @@index([key])
}

// ─────────────────────────────── Мини-игры ───────────────────────────────

enum GameKind {
  ROULETTE
  CRASH
}

model GameRound {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game           GameKind
  betVc          Int
  target         Float? // выбранный множитель (рулетка) или точка выхода (краш)
  result         Float // выпавший множитель
  payoutVc       Int
  won            Boolean
  serverSeedHash String
  clientSeed     String
  nonce          Int
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([game, createdAt])
}

/// Пара сидов для provably fair. Активный сид один на игрока.
model Seed {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int       @default(0)
  active         Boolean   @default(true)
  revealedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, active])
}

// ──────────────────────── Логи и антифрод ────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  targetUserId String?
  target       User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  ip           String?
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model SuspiciousFlag {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // MULTI_ACCOUNT_IP | GAME_ANOMALY | VC_SPIKE | LOGIN_BRUTE | NEW_GEO
  severity   Int      @default(1) // 1 низкая … 3 высокая
  details    Json?
  resolved   Boolean  @default(false)
  resolvedBy String?
  createdAt  DateTime @default(now())

  @@index([resolved, severity, createdAt])
  @@index([userId])
}

// ──────────────────────────────── Новости ────────────────────────────────

model News {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  summary  String
  body     String
  coverUrl String?

  published     Boolean   @default(true)
  pinned        Boolean   @default(false)
  /// Объявить новость в игровом чате — плагин заберёт её сам.
  broadcast     Boolean   @default(false)
  broadcastedAt DateTime?

  authorId  String?
  author    User?    @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, pinned, createdAt])
}

// ─────────────────────── Заявки медиа-партнёров ───────────────────────

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model PartnerApplication {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("ApplicationAuthor", fields: [userId], references: [id], onDelete: Cascade)

  platform    String // youtube | shorts | twitch | tiktok | discord | trovo | other
  channelUrl  String
  audience    String // метрики своими словами: просмотры, зрители, участники
  contact     String // телеграм или дискорд для связи
  comment     String?
  /// Желаемый промокод — если заявку одобрят, он и станет кодом партнёра.
  desiredCode String?

  status     ApplicationStatus @default(PENDING)
  reviewNote String?
  reviewedBy String?
  reviewer   User?             @relation("ApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([status, createdAt])
  @@index([userId])
}
