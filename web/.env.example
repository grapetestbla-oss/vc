# Подключение к базе
DATABASE_URL="postgresql://vanilla:CHANGE_ME@postgres:5432/vanilla"

# Общий секрет между сайтом и плагином. Сгенерировать: openssl rand -hex 32
MC_SERVER_TOKEN="CHANGE_ME"

# Экономика и игры
GAME_RTP=0.95
# Потолка ставки и дневного лимита проигрыша нет — только нижняя граница.
GAME_MIN_BET=10
# Курс пополнения: сколько VC даёт один рубль.
VC_PER_RUB=2
PROMO_REWARD_VC=1000
PROMO_REQUIRED_LEVEL=3
# Доля медиапартнёра от пополнений приведённых игроков, проценты.
PARTNER_SHARE_PERCENT=10

# Приём платежей FreeKassa. Пусто — пополнение подтверждается вручную.
# Адрес уведомлений в кабинете FreeKassa: https://<домен>/api/payments/freekassa
FREEKASSA_MERCHANT_ID=""
FREEKASSA_SECRET1=""
FREEKASSA_SECRET2=""
# Необязательно: адрес формы, валюта и список IP уведомлений.
FREEKASSA_PAY_URL="https://pay.fk.money/"
FREEKASSA_CURRENCY="RUB"
FREEKASSA_IPS="168.119.157.136,168.119.60.227,178.154.197.79,51.250.54.238"

# Управление игровым сервером во вкладке «Сервер» (только 5 уровень).
GAME_PANEL_URL=""
GAME_PANEL_KEY=""
GAME_PANEL_SERVER_ID=""
