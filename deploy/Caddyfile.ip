# Запасной конфиг: домен ещё не указывает на сервер, работаем по IP без TLS.
# Авторизацию игроков в этом режиме включать нельзя — пароли пойдут открыто.
:80 {
	encode gzip

	@mc path /api/mc/*
	handle @mc {
		@foreign not remote_ip {$MC_SERVER_IP:0.0.0.0/0}
		respond @foreign 403
		reverse_proxy 127.0.0.1:3000
	}

	reverse_proxy 127.0.0.1:3000

	log {
		output file /data/access.log
		format json
	}
}
