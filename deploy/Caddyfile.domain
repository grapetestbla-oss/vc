# Боевой конфиг: домен с сертификатом Let's Encrypt.
{$SITE_DOMAIN} {
	encode gzip

	# API для плагина: пускаем только с IP игрового сервера.
	@mc path /api/mc/*
	handle @mc {
		@foreign not remote_ip {$MC_SERVER_IP:0.0.0.0/0}
		respond @foreign 403
		reverse_proxy 127.0.0.1:3000
	}

	# API агента выкатки: он живёт на этой же машине и ходит на 127.0.0.1
	# напрямую. Снаружи сюда стучаться незачем — токен есть, но лишний
	# открытый маршрут к выкатке боевого сайта не нужен.
	@deploy path /api/deploy/*
	respond @deploy 403

	reverse_proxy 127.0.0.1:3000

	log {
		output file /data/access.log
		format json
	}
}

# Технический сайт: та же сборка, своя база, вход только по списку STAGING_LOGINS.
# Заслонку держит сам сайт, Caddy только доводит запрос до нужного контейнера.
tech.{$SITE_DOMAIN} {
	encode gzip

	# Агент выкатки со стендом не разговаривает никогда.
	@closed path /api/deploy/*
	respond @closed 403

	# Плагин — только с тестового игрового сервера и только если его адрес
	# задан. По умолчанию сюда пускается лишь сам хост, то есть снаружи
	# закрыто: стенд не должен отвечать первому, кто узнал токен.
	@techmc path /api/mc/*
	handle @techmc {
		@foreign not remote_ip {$TECH_MC_SERVER_IP:127.0.0.1/32}
		respond @foreign 403
		reverse_proxy 127.0.0.1:3001
	}

	reverse_proxy 127.0.0.1:3001

	log {
		output file /data/tech-access.log
		format json
	}
}
